# 徒步助手环境变量配置
# 复制此文件为 .env 并填入真实值

# 默认 LLM Provider: deepseek 或 anthropic
LLM_PROVIDER=deepseek

# DeepSeek API (推荐 - 国内可用，便宜)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic Claude (备选 - 需要国外网络)
ANTHROPIC_API_KEY=sk-ant-api03-your-key
# HIKING_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# 数据库
DATABASE_URL=postgresql+asyncpg://hiking:hiking123@localhost:5432/hiking_assistant

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-me-to-a-random-string

# 搜索 API
TAVILY_API_KEY=

# 天气 API (可选)
OPENWEATHER_API_KEY=

# 前端地址（密码重置链接用）
FRONTEND_URL=http://localhost:5173

# SMTP 邮件（生产模式密码重置必填；为空时 forgot-password 会明确报错而不是假装已发送）
# 示例（QQ 邮箱 / 163 等通用格式）：
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=your-account@qq.com
# SMTP_PASSWORD=your-smtp-auth-code
# SMTP_FROM=your-account@qq.com
# SMTP_USE_TLS=true   # true=STARTTLS(587), false=SSL直连(465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=false
