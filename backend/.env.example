# 徒步助手环境变量配置
# 复制此文件为 .env 并填入真实值

# 默认 LLM Provider: deepseek 或 anthropic
LLM_PROVIDER=deepseek

# DeepSeek API (推荐 - 国内可用，便宜)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic Claude (备选 - 需要国外网络)
ANTHROPIC_API_KEY=sk-ant-api03-your-key
# HIKING_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# 数据库
DATABASE_URL=postgresql+asyncpg://hiking:hiking123@localhost:5432/hiking_assistant

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-me-to-a-random-string

# 搜索 API
TAVILY_API_KEY=

# 天气 API (可选)
OPENWEATHER_API_KEY=
